<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>ProtoContract.AspNetCore</PackageId>
    <Version>0.3.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Combined gRPC endpoint and contract registration with global enforcement.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="[2.71.0,3.0.0)" />
    <ProjectReference Include="../dotnet/ProtoContract.Runtime.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../dotnet/LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
